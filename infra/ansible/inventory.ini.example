[control_plane]
control-plane ansible_host=YOUR_CONTROL_PLANE_PUBLIC_IP private_ip=YOUR_CONTROL_PLANE_PRIVATE_IP

[workers]
worker-1 ansible_host=YOUR_WORKER_1_PUBLIC_IP private_ip=YOUR_WORKER_1_PRIVATE_IP
worker-2 ansible_host=YOUR_WORKER_2_PUBLIC_IP private_ip=YOUR_WORKER_2_PRIVATE_IP

[k3s_cluster:children]
control_plane
workers

[k3s_cluster:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/id_ed25519
